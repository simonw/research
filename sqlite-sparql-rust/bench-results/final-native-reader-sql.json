 "queries": [
  {
   "id": "Q1",
   "title": "star-4 (class + age + city + name)",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q01-star4.rq",
   "sha256": "796a0253d23bcc5f9dc5554286a1a74e43af7b8d35094a4970e217d90c86f888",
   "text": "# Q1: star-4 (class + age + city + name)\n# dataset: social\n# A subject star with one constant object (10% of the persons are :C3).\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX : <http://example.org/social/>\nSELECT ?x ?a ?c ?n\nWHERE {\n  ?x rdf:type :C3 ;\n     :age ?a ;\n     :city ?c ;\n     :name ?n .\n}\n"
  },
  {
   "id": "Q2",
   "title": "BSBM product star-6",
   "dataset": "bsbm",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q02-bsbm-star6.rq",
   "sha256": "f37468a41d05a096e1ca85881d5132175c66b784cda07334d677308c6eed5b97",
   "text": "# Q2: BSBM product star-6\n# dataset: bsbm\n# A six-pattern product star anchored on one popular feature.\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX bsbm: <http://example.org/bsbm/vocabulary/>\nPREFIX inst: <http://example.org/bsbm/instances/>\nSELECT ?product ?type ?label ?producer ?n1 ?t1\nWHERE {\n  ?product bsbm:productFeature inst:ProductFeature3 ;\n           rdf:type ?type ;\n           rdfs:label ?label ;\n           bsbm:producer ?producer ;\n           bsbm:productPropertyNumeric1 ?n1 ;\n           bsbm:productPropertyTextual1 ?t1 .\n}\n"
  },
  {
   "id": "Q3",
   "title": "chain-2 COUNT",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q03-chain2-count.rq",
   "sha256": "6b240661999c27b237ebc78bfd0f3c4d3a43bd54431d431e55b854cc0433596f",
   "text": "# Q3: chain-2 COUNT\n# dataset: social\n# Friends of friends; always 9 x persons solutions because every out-degree is 3.\nPREFIX : <http://example.org/social/>\nSELECT (COUNT(*) AS ?count)\nWHERE {\n  ?a :knows ?b .\n  ?b :knows ?c .\n}\n"
  },
  {
   "id": "Q4",
   "title": "selective chain-3 from a constant",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q04-chain3-const.rq",
   "sha256": "4c753226d50b44894b4b8d280e84a3ed2672996d58300f35369faa4ca5def2ea",
   "text": "# Q4: selective chain-3 from a constant\n# dataset: social\n# Three hops from :p123 (exactly 27 solutions, duplicates included).\nPREFIX : <http://example.org/social/>\nSELECT ?a ?b ?c\nWHERE {\n  :p123 :knows ?a .\n  ?a :knows ?b .\n  ?b :knows ?c .\n}\n"
  },
  {
   "id": "Q5",
   "title": "OPTIONAL with a type check inside",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q05-optional.rq",
   "sha256": "9ed8d27ba3d496ae6eac3fa2aee51786b8e59f4e6a88e0117a01411092a7fa05",
   "text": "# Q5: OPTIONAL with a type check inside\n# dataset: social\n# Every :C3 person, with the :C4 persons they know (unbound when there are none).\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX : <http://example.org/social/>\nSELECT ?x ?y\nWHERE {\n  ?x rdf:type :C3 .\n  OPTIONAL {\n    ?x :knows ?y .\n    ?y rdf:type :C4 .\n  }\n}\n"
  },
  {
   "id": "Q6",
   "title": "FILTER(?a > 90)",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q06-filter-range.rq",
   "sha256": "fbb2eae8084bb3c718c544f7b3dcc946089474e74dac404264966a024c733ef0",
   "text": "# Q6: FILTER(?a > 90)\n# dataset: social\n# Selective integer range (about 0.7% of the persons).\nPREFIX : <http://example.org/social/>\nSELECT ?x ?a\nWHERE {\n  ?x :age ?a .\n  FILTER(?a > 90)\n}\n"
  },
  {
   "id": "Q7",
   "title": "REGEX on names",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q07-regex.rq",
   "sha256": "b0e497d43b0b3498bf77379cf02aa0d8262bd01cf5725675e6eaf9fc05380718",
   "text": "# Q7: REGEX on names\n# dataset: social\n# Case-insensitive anchored regular expression over every name.\nPREFIX : <http://example.org/social/>\nSELECT ?x ?n\nWHERE {\n  ?x :name ?n .\n  FILTER(REGEX(?n, \"^person 1[0-9]*7$\", \"i\"))\n}\n"
  },
  {
   "id": "Q8",
   "title": "GROUP BY + COUNT + ORDER BY DESC LIMIT 10",
   "dataset": "social",
   "ordered": true,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q08-groupby-top10.rq",
   "sha256": "93af9ec0a89edc0b945a6d04e81bbfe8b784e8253b4255b822ed120960ac3494",
   "text": "# Q8: GROUP BY + COUNT + ORDER BY DESC LIMIT 10\n# dataset: social\n# ordered: true\n# The ten most populous cities; ?c breaks ties so the order is total.\nPREFIX : <http://example.org/social/>\nSELECT ?c (COUNT(?x) AS ?n)\nWHERE {\n  ?x :city ?c .\n}\nGROUP BY ?c\nORDER BY DESC(?n) ?c\nLIMIT 10\n"
  },
  {
   "id": "Q9",
   "title": "ORDER BY DESC(?age) ?x LIMIT 10",
   "dataset": "social",
   "ordered": true,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q09-topk-age.rq",
   "sha256": "909d13a480ae071b3efbc159344a801cc18a3d1c44604382aa0e11854e0e907c",
   "text": "# Q9: ORDER BY DESC(?age) ?x LIMIT 10\n# dataset: social\n# ordered: true\n# Top-k over an integer property; ?x breaks ties so the order is total.\nPREFIX : <http://example.org/social/>\nSELECT ?x ?age\nWHERE {\n  ?x :age ?age .\n}\nORDER BY DESC(?age) ?x\nLIMIT 10\n"
  },
  {
   "id": "Q10",
   "title": "DISTINCT over a join",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q10-distinct-join.rq",
   "sha256": "32706d908433fffe3f379e272c251592d3cda97fc15a68043323fa2842746eb2",
   "text": "# Q10: DISTINCT over a join\n# dataset: social\n# (home city, friend's class) pairs: at most 10 x cities rows out of 3 x persons join rows.\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX : <http://example.org/social/>\nSELECT DISTINCT ?c ?cls\nWHERE {\n  ?x :knows ?y .\n  ?x :city ?c .\n  ?y rdf:type ?cls .\n}\n"
  },
  {
   "id": "Q11",
   "title": "UNION",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q11-union.rq",
   "sha256": "098f8a4b2efacbdc1ea750925bdac8e455dd690300c157acf5b3164865432df6",
   "text": "# Q11: UNION\n# dataset: social\n# Outgoing :knows of :C1 persons plus incoming :knows of :C2 persons.\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX : <http://example.org/social/>\nSELECT ?x ?y\nWHERE {\n  { ?x rdf:type :C1 . ?x :knows ?y . }\n  UNION\n  { ?x rdf:type :C2 . ?y :knows ?x . }\n}\n"
  },
  {
   "id": "Q12",
   "title": "MINUS",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q12-minus.rq",
   "sha256": "9ccb8cf4f8483739baf2a4016a161956b45d641f7eed190e103aeba19462c769",
   "text": "# Q12: MINUS\n# dataset: social\n# :C5 persons who know no other :C5 person (?x is shared, so MINUS = NOT EXISTS here).\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX : <http://example.org/social/>\nSELECT ?x\nWHERE {\n  ?x rdf:type :C5 .\n  MINUS {\n    ?x :knows ?y .\n    ?y rdf:type :C5 .\n  }\n}\n"
  },
  {
   "id": "Q13",
   "title": ":p1 :knows+ ?y COUNT",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q13-knows-plus-count.rq",
   "sha256": "71d16c06a0c1ce36287610d66c4c4c82291bc1894f11940f2fb94fc3b13bf1e6",
   "text": "# Q13: :p1 :knows+ ?y COUNT\n# dataset: social\n# Transitive closure from one person (set semantics: each reachable person once).\nPREFIX : <http://example.org/social/>\nSELECT (COUNT(*) AS ?count)\nWHERE {\n  :p1 :knows+ ?y .\n}\n"
  },
  {
   "id": "Q14",
   "title": "?x rdf:type/rdfs:subClassOf* bsbm:Product",
   "dataset": "bsbm",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q14-subclass-path.rq",
   "sha256": "e848a9fb87dc50e12f85e4ac5a838ee327e49fde81a3c98217a4f1bf65dc9f3a",
   "text": "# Q14: ?x rdf:type/rdfs:subClassOf* bsbm:Product\n# dataset: bsbm\n# Every product, found through the 4-level type hierarchy (one row per product).\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX bsbm: <http://example.org/bsbm/vocabulary/>\nSELECT ?x\nWHERE {\n  ?x rdf:type/rdfs:subClassOf* bsbm:Product .\n}\n"
  },
  {
   "id": "Q15",
   "title": "point lookup :p123 ?p ?o",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q15-point-lookup.rq",
   "sha256": "98747ced950a053eda892f51cc00a06dfc035836f37cd20c398c4b1f723ff806",
   "text": "# Q15: point lookup :p123 ?p ?o\n# dataset: social\n# All eight triples of one subject.\nPREFIX : <http://example.org/social/>\nSELECT ?p ?o\nWHERE {\n  :p123 ?p ?o .\n}\n"
  },
  {
   "id": "Q16",
   "title": "COUNT(*) {?s ?p ?o}",
   "dataset": "social",
   "ordered": false,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q16-count-all.rq",
   "sha256": "4dcbfe01f01ccb227b1d2cdef95adb2f31a3fdc91d2ad83d62a75c9b5b115de6",
   "text": "# Q16: COUNT(*) {?s ?p ?o}\n# dataset: social\n# Size of the default graph.\nSELECT (COUNT(*) AS ?count)\nWHERE {\n  ?s ?p ?o .\n}\n"
  },
  {
   "id": "Q17",
   "title": "BSBM offers: price range + date filter + ORDER BY price LIMIT 10",
   "dataset": "bsbm",
   "ordered": true,
   "path": "/home/user/research/sqlite-sparql-rust/py/queries/q17-bsbm-offers.rq",
   "sha256": "8618a201d9cb17c312fb10a27723ee8c0872a23553f101c560b294feb807d58d",
   "text": "# Q17: BSBM offers: price range + date filter + ORDER BY price LIMIT 10\n# dataset: bsbm\n# ordered: true\n# Prices mix xsd:decimal (some non-canonical, e.g. \"12.50\") and xsd:integer but never\n# compare equal across the two, and ?offer breaks ties, so the order is total.\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nPREFIX bsbm: <http://example.org/bsbm/vocabulary/>\nSELECT ?offer ?price ?vendor ?product ?validTo\nWHERE {\n  ?offer bsbm:price ?price ;\n         bsbm:validTo ?validTo ;\n         bsbm:vendor ?vendor ;\n         bsbm:product ?product .\n  FILTER(?price >= 500 && ?price <= 1000)\n  FILTER(?validTo >= \"2008-06-01T00:00:00\"^^xsd:dateTime)\n}\nORDER BY ?price ?offer\nLIMIT 10\n"
  }
 ],
